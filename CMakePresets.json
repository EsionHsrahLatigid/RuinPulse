{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "engine-debug",
      "displayName": "RuinPulse engine tests (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/engine-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "RUINPULSE_BUILD_PLUGIN": "OFF",
        "RUINPULSE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "plugin-release",
      "displayName": "RuinPulse plugin bundles (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/plugin-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "RUINPULSE_BUILD_PLUGIN": "ON",
        "RUINPULSE_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "engine-debug",
      "configurePreset": "engine-debug",
      "targets": [
        "ruinpulse_engine_tests"
      ]
    },
    {
      "name": "plugin-release",
      "configurePreset": "plugin-release",
      "targets": [
        "ruinpulse_release_bundles",
        "ruinpulse_engine_tests",
        "ruinpulse_plugin_bridge_tests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "engine-debug",
      "configurePreset": "engine-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "plugin-release",
      "configurePreset": "plugin-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
